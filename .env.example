# Development template only. Configure issuer/audience from the existing gateway contract.
# Never place real tokens, secrets, passwords or private keys in this file.
# Local workstation only: enables loopback-bound demo JWT issuance for abc@gmail.com.
# Never use this profile in staging or production.
SPRING_PROFILES_ACTIVE=local-auth
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres?connectTimeout=10&sslmode=prefer&currentSchema=ecabin_ledger
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-local-only
DB_SCHEMA=ecabin_ledger
# Not required by the local-auth profile. Required for the enterprise gateway profile.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=
OAUTH2_AUDIENCE=
CORS_ALLOWED_ORIGINS=http://localhost:3000
DB_POOL_SIZE=10

# Test: use an isolated PostgreSQL database and gateway-approved test issuer/audience.
# Staging: inject staging issuer, audience, DB credentials and exact web origin from secret/config management.
# Production: inject production issuer, audience, managed DB credentials, pool sizing and exact web origin.
# Do not copy development values into staging or production.
